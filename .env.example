RCON_HOST=minecraft
RCON_PORT=25575
RCON_PASSWORD=copy-the-value-from-the-minecraft-stacks-env
DASH_PORT=8300
# Optional UI login — set both to enable HTTP Basic auth, leave unset to disable
#DASH_USER=
#DASH_PASS=
# Player avatar sources for the dashboard cards ({name} is the placeholder).
# The backend fetches + caches these; the browser never talks to the internet.
# Leave unset for the defaults below; setting AVATAR_URL empty (AVATAR_URL=)
# disables ALL avatar fetching — cards then show a built-in placeholder.
#AVATAR_URL=https://mc-heads.net/avatar/{name}/64
#AVATAR_BODY_URL=https://mc-heads.net/body/{name}/100
# Item sprites for the Biomes catalog, proxied + cached the same way; set
# empty (ITEM_ICON_URL=) to disable fetching.
#ITEM_ICON_URL=https://mc.nerothe.com/img/1.21/minecraft_{id}.png

# --- Email recaps (optional) -------------------------------------------------
# Fill these in to enable the daily/weekly player recap emails (recipients are
# configured on the dashboard's Settings tab). For Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password — create one at
# myaccount.google.com/apppasswords>, SMTP_FROM defaults to SMTP_USER.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=
# Sending schedule (hours are local to the container; set TZ= to your zone,
# e.g. TZ=America/New_York, or times are UTC). Weekly day: 0=Monday … 6=Sunday.
#RECAP_HOUR=7
#RECAP_WEEKLY_DAY=0
#RECAP_SERVER_NAME=Team Green SMP
#TZ=America/New_York
