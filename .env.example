RCON_HOST=minecraft
RCON_PORT=25575
RCON_PASSWORD=copy-the-value-from-the-minecraft-stacks-env
DASH_PORT=8300
# Optional UI login — set both to enable HTTP Basic auth, leave unset to disable
#DASH_USER=
#DASH_PASS=
# Player-head source for the dashboard cards ({name} is the placeholder). The
# backend fetches + caches these; the browser never talks to the internet.
# Leave unset for the default below; set empty (AVATAR_URL=) to disable all
# outbound fetches — cards then show a built-in placeholder face.
#AVATAR_URL=https://mc-heads.net/avatar/{name}/64
